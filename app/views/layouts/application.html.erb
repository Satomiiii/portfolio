<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>CookLog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all" %>

    <!-- ✅ これを追加：Turbo / Stimulus を動かすため -->
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand">
          <%= link_to root_path, class: "brand-link" do %>
            <span class="brand-mark">🍳</span>
            <span class="brand-name">CookLog</span>
          <% end %>
        </div>

        <nav class="nav">
          <%= link_to "料理一覧", dishes_path, class: "nav-link" %>
          <%= link_to "料理登録", new_dish_path, class: "nav-link" %>

          <!-- Devise未実装のため仮リンク -->
          <%= link_to "ログイン（仮）", "#",
                class: "nav-link is-disabled",
                aria: { disabled: true } %>

          <%= link_to "新規登録（仮）", "#",
                class: "nav-link primary is-disabled",
                aria: { disabled: true } %>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <div class="container">
        <% if notice.present? %>
          <div class="flash notice"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="flash alert"><%= alert %></div>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <small>© <%= Time.current.year %> CookLog</small>
      </div>
    </footer>
  </body>
</html>
