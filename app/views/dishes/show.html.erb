<h1>料理詳細</h1>

<div class="dish-card">
  <div class="dish-header">
    <h3><%= @dish.name %></h3>
    <span class="category"><%= @dish.category %></span>
  </div>

  <p class="memo">
    <%= @dish.memo.presence || "メモは未登録です" %>
  </p>

  <p class="date">
    登録日：<%= @dish.created_at.strftime("%Y/%m/%d") %>
  </p>

  <div class="dish-actions">
    <%= link_to "ログを追加", new_dish_cook_log_path(@dish), class: "btn primary" %>
    <%= link_to "編集", edit_dish_path(@dish), class: "btn ghost" %>
    <%= link_to "一覧へ戻る", dishes_path, class: "btn" %>

    <%= button_to "料理を削除",
                  dish_path(@dish),
                  method: :delete,
                  form: { data: { turbo_confirm: "料理ごと削除します。本当に削除しますか？" } },
                  class: "btn danger" %>
  </div>
</div>

<hr>

<h2>試行ログ</h2>

<% if @cook_logs.any? %>
  <div class="log-list">
    <% @cook_logs.each do |log| %>
      <div class="log-card">
        <div class="log-header">
          <strong>第<%= log.trial_number %>回</strong>
        </div>

        <p><strong>反省点：</strong><%= log.reflection %></p>
        <p><strong>次回：</strong><%= log.next_plan %></p>

        <div class="dish-actions">
          <%= link_to "編集",
                      edit_dish_cook_log_path(@dish, log),
                      class: "btn ghost" %>

          <%= button_to "削除",
                        dish_cook_log_path(@dish, log),
                        method: :delete,
                        form: { data: { turbo_confirm: "このログを削除しますか？" } },
                        class: "btn danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>まだログがありません。「ログを追加」から最初の試行を記録しましょう。</p>
<% end %>
