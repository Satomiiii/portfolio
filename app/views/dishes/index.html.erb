<h1>登録料理一覧</h1>

<div class="actions">
  <%= link_to "料理を登録する", new_dish_path, class: "btn primary" %>
</div>

<div class="dish-grid">
  <% @dishes.each do |dish| %>
    <div class="dish-card">
      <div class="dish-header">
        <h3>
          <%= link_to dish.name, dish_path(dish), class: "dish-title-link" %>
        </h3>

        <span class="category"><%= dish.category %></span>
      </div>

      <p class="memo"><%= dish.memo.presence || "メモは未登録です" %></p>

      <p class="date">
        登録日： <%= dish.created_at.strftime("%Y/%m/%d") %>
      </p>

      <p class="trial-count">
        試行回数：
        <%= dish.respond_to?(:cook_logs_count) ? dish.cook_logs_count : dish.cook_logs.size %>回
      </p>

      <% if dish.respond_to?(:last_cooked_at) && dish.last_cooked_at.present? %>
        <% last = dish.last_cooked_at %>
        <% last = Time.zone.parse(last) if last.is_a?(String) %>
        <p class="last-cooked">
          最終試行日： <%= last.strftime("%Y/%m/%d") %>
        </p>
      <% end %>

      <% if dish.respond_to?(:latest_next_plan) && dish.latest_next_plan.present? %>
        <p class="next-plan">
          <strong>次回：</strong><%= dish.latest_next_plan %>
        </p>
      <% end %>

      <div class="dish-actions">
        <%= link_to "詳細（ログ）", dish_path(dish), class: "btn primary" %>
        <%= link_to "編集", edit_dish_path(dish), class: "btn ghost" %>
        <%= link_to "削除", dish_path(dish),
              data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
              class: "btn danger" %>
      </div>
    </div>
  <% end %>
</div>
