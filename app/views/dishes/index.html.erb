<h1>登録料理一覧</h1>

<div class="actions">
  <%= link_to "料理を登録する", new_dish_path, class: "btn primary" %>
</div>

<div class="dish-grid">
  <% @dishes.each do |dish| %>
    <div class="dish-card">
      <div class="dish-header">
        <h3><%= link_to dish.name, dish_path(dish) %></h3>
        <span class="category"><%= dish.category %></span>
      </div>

      <p class="memo"><%= dish.memo.presence || "メモは未登録です" %></p>

      <p class="date">
        登録日：<%= dish.created_at.strftime("%Y/%m/%d") %>
      </p>

      <div class="dish-actions">
        <%= link_to "編集", edit_dish_path(dish), class: "btn ghost" %>

        <%= button_to "削除",
              dish_path(dish),
              method: :delete,
              data: { turbo_confirm: "本当に削除しますか？" },
              class: "btn danger",
              form_class: "inline-form" %>
      </div>
    </div>
  <% end %>
</div>





