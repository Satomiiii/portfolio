<%= form_with model: dish, local: true do |f| %>
  <% if dish.errors.any? %>
    <div class="errors">
      <p class="errors-title">入力内容を確認してください</p>
      <ul class="errors-list">
        <% dish.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "料理名", class: "label" %>
    <%= f.text_field :name, class: "input", placeholder: "例：鶏むねハンバーグ" %>
  </div>

  <div class="field">
    <%= f.label :category, "カテゴリ", class: "label" %>
    <%= f.text_field :category, class: "input", placeholder: "例：主菜 / 副菜 / 汁物" %>
  </div>

  <div class="field">
    <%= f.label :memo, "メモ（任意）", class: "label" %>
    <%= f.text_area :memo, class: "textarea", rows: 6, placeholder: "例：参考レシピURL、ポイント、材料のメモなど" %>
  </div>

  <div class="form-actions">
    <%= f.submit submit_label, class: "btn primary" %>
    <%= link_to "一覧に戻る", dishes_path, class: "btn ghost" %>
  </div>
<% end %>
