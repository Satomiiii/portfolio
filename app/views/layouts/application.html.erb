<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>CookLog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand">
          <%= link_to root_path, class: "brand-link" do %>
            <span class="brand-mark">🍳</span>
            <span class="brand-name">CookLog</span>
          <% end %>
        </div>

        <nav class="nav">
          <!-- Devise未実装のため仮リンク -->
          <%= link_to "ログイン", "#",
                class: "nav-link is-disabled",
                aria: { disabled: true } %>

          <%= link_to "新規登録", "#",
                class: "nav-link primary is-disabled",
                aria: { disabled: true } %>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <small>© <%= Time.current.year %> CookLog</small>
      </div>
    </footer>
  </body>
</html>
